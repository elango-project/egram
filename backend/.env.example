# ============================================================
# Egram Backend – Local Development Environment
# ============================================================
# Copy this file to .env or set these environment variables

# Database (Neon PostgreSQL)
DB_URL=jdbc:postgresql://<your-neon-host>.aws.neon.tech/neondb?sslmode=require&channel_binding=require
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password

# JWT Secret (minimum 32 chars)
JWT_SECRET=your_jwt_secret_key_change_me

# Admin Seeder (set to true for first-time setup)
SEED_ADMIN=true

# Logging
LOG_LEVEL=DEBUG
